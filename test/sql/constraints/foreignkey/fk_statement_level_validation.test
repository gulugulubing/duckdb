# name: test/sql/constraints/foreignkey/fk_statement_level_validation.test
# description: Foreign key constraints are validated at the end of the statement: rows may reference other rows inserted by the same statement (#7168)
# group: [foreignkey]

# issue #7168: inserting a complete tree in a single statement is valid
statement ok
CREATE TABLE t(id INT PRIMARY KEY, parent INT REFERENCES t(id));

statement ok
INSERT INTO t VALUES (1, NULL), (2, 1), (3, 2);

query II
SELECT id, parent FROM t ORDER BY id;
----
1	NULL
2	1
3	2

# rows may reference rows that appear later in the statement
statement ok
CREATE TABLE t2(id INT PRIMARY KEY, parent INT REFERENCES t2(id));

statement ok
INSERT INTO t2 VALUES (3, 2), (2, 1), (1, NULL);

query II
SELECT id, parent FROM t2 ORDER BY id;
----
1	NULL
2	1
3	2

# rows may reference rows of a previous chunk of the same statement (multi-chunk insert)
statement ok
CREATE TABLE t3(id INT PRIMARY KEY, parent INT REFERENCES t3(id));

statement ok
INSERT INTO t3 SELECT i, CASE WHEN i = 1 THEN NULL ELSE i - 1 END FROM range(1, 5000) t(i);

query I
SELECT count(*) FROM t3;
----
4999

# inserts with RETURNING are validated at statement level as well
statement ok
CREATE TABLE t4(id INT PRIMARY KEY, parent INT REFERENCES t4(id));

query II
INSERT INTO t4 VALUES (1, NULL), (2, 1) RETURNING *;
----
1	NULL
2	1

# actual violations are still detected
statement error
INSERT INTO t VALUES (4, 99);
----
Constraint Error: Violates foreign key constraint because key "id: 99" does not exist in the referenced table

# violations are detected even if other rows of the same statement are valid
statement error
INSERT INTO t VALUES (5, 4), (6, 77);
----
Constraint Error

# the failed statement inserted no rows
query I
SELECT count(*) FROM t;
----
3

statement ok
INSERT INTO t VALUES (4, 4);

# cross-table foreign keys keep working
statement ok
CREATE TABLE p(id INT PRIMARY KEY);

statement ok
CREATE TABLE f(j INT REFERENCES p(id));

statement ok
INSERT INTO p VALUES (1), (2);

statement ok
INSERT INTO f VALUES (1), (2);

statement error
INSERT INTO f VALUES (3);
----
Constraint Error: Violates foreign key constraint because key "id: 3" does not exist in the referenced table

# multiple foreign keys on the same table are all verified
statement ok
CREATE TABLE p2(id INT PRIMARY KEY);

statement ok
CREATE TABLE m(a INT REFERENCES t(id), b INT REFERENCES p2(id));

statement ok
INSERT INTO p2 VALUES (10);

statement ok
INSERT INTO m VALUES (4, 10), (3, 10);

statement error
INSERT INTO m VALUES (2, 99);
----
Constraint Error

statement error
INSERT INTO m VALUES (99, 10);
----
Constraint Error

# referencing rows inserted by earlier statements of the same transaction
statement ok
CREATE TABLE t5(id INT PRIMARY KEY, parent INT REFERENCES t5(id));

statement ok
BEGIN;

statement ok
INSERT INTO t5 VALUES (1, NULL);

statement ok
INSERT INTO t5 VALUES (2, 1), (3, 2);

statement ok
COMMIT;

query I
SELECT count(*) FROM t5;
----
3

# an actual violation inside an explicit transaction aborts the transaction
statement ok
CREATE TABLE t6(id INT PRIMARY KEY, parent INT REFERENCES t6(id));

statement ok
BEGIN;

statement ok
INSERT INTO t6 VALUES (1, NULL);

statement error
INSERT INTO t6 VALUES (2, 99);
----
Constraint Error

statement error
INSERT INTO t6 VALUES (2, 1);
----
TransactionContext Error: Current transaction is aborted (please ROLLBACK)

statement ok
ROLLBACK;

query I
SELECT count(*) FROM t6;
----
0

# UPDATE rewriting into DELETE + INSERT keeps verifying foreign keys
statement ok
CREATE TABLE song(artist INT REFERENCES p(id), name VARCHAR);

statement ok
INSERT INTO song VALUES (1, 'A');

statement error
UPDATE song SET artist = 5 WHERE name = 'A';
----
Constraint Error

# NULL foreign keys are not checked
statement ok
INSERT INTO song VALUES (NULL, 'B');
