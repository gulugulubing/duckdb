# name: test/sql/copy_database/copy_database_fk.test
# description: Test COPY DATABASE with foreign key constraint
# group: [copy_database]

# the tables are created in an explicitly attached in-memory database: under storage test configs
# (e.g. verify_compression) the test runs on a persistent database whose default catalog name
# is the file name, so "memory" is not a valid source for COPY FROM DATABASE
statement ok
ATTACH ':memory:' AS src

statement ok
USE src

statement ok
CREATE TABLE pk_integers(i INTEGER PRIMARY KEY)

statement ok
CREATE TABLE fk_integers(j INTEGER, FOREIGN KEY (j) REFERENCES pk_integers(i))

statement ok
INSERT INTO pk_integers VALUES (1), (2), (3)

statement ok
INSERT INTO fk_integers VALUES (1), (2)

# now export the db
statement ok
ATTACH ':memory:' AS db1

statement ok
COPY FROM DATABASE src TO db1

statement ok
USE db1

# check foreign key constraint
statement error
INSERT INTO fk_integers VALUES (4)
----

statement ok
INSERT INTO fk_integers VALUES (3)

statement error
DELETE FROM pk_integers WHERE i=3
----

statement ok
DELETE FROM fk_integers WHERE j=3

statement ok
DELETE FROM pk_integers WHERE i=3

statement error
UPDATE pk_integers SET i=5 WHERE i=2
----

statement error
UPDATE fk_integers SET i=4 WHERE j=2
----

statement error
UPDATE fk_integers SET i=4 WHERE j=2
----

statement error
DROP TABLE pk_integers;
----

statement ok
DROP TABLE fk_integers;

statement ok
DROP TABLE pk_integers;

# a chain of foreign keys forces transitive serialization of the inserts (chain_a -> chain_b -> chain_c),
# while the table without foreign keys is not serialized against anything
statement ok
USE src

statement ok
CREATE TABLE chain_a(i INTEGER PRIMARY KEY)

statement ok
CREATE TABLE chain_b(j INTEGER PRIMARY KEY, FOREIGN KEY (j) REFERENCES chain_a(i))

statement ok
CREATE TABLE chain_c(k INTEGER, FOREIGN KEY (k) REFERENCES chain_b(j))

statement ok
CREATE TABLE no_fk(x INTEGER)

statement ok
INSERT INTO chain_a VALUES (1), (2), (3)

statement ok
INSERT INTO chain_b VALUES (1), (2)

statement ok
INSERT INTO chain_c VALUES (1), (2)

statement ok
INSERT INTO no_fk VALUES (1), (2)

statement ok
ATTACH ':memory:' AS db2

statement ok
COPY FROM DATABASE src TO db2

statement ok
USE db2

query I
SELECT count(*) FROM chain_a
----
3

query I
SELECT count(*) FROM chain_b
----
2

query I
SELECT count(*) FROM chain_c
----
2

query I
SELECT count(*) FROM no_fk
----
2

# the foreign keys are enforced in the copied database
statement error
INSERT INTO chain_b VALUES (4)
----

statement error
INSERT INTO chain_c VALUES (3)
----

statement ok
INSERT INTO chain_b VALUES (3)

statement ok
INSERT INTO chain_c VALUES (3)

query I
SELECT count(*) FROM chain_c
----
3
